[Unit]
Description=Teo, the ATR Lab Discord assistant
After=network-online.target
Wants=network-online.target

[Service]
User=teo
WorkingDirectory=/opt/teo/app
EnvironmentFile=/etc/teo.env
ExecStart=/opt/teo/run.sh
# Reminders live in /var/lib/teo (STATE_DIRECTORY); it survives deploys and restarts.
StateDirectory=teo
StateDirectoryMode=0700
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
