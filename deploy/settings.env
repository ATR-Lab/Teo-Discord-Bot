# Teo's runtime settings (no secrets). deploy.sh copies this file to /etc/teo.env on the instance.
# Change a value here, merge to main and the deploy workflow ships it. Secrets live in SSM.
TEO_GUILD_ID=809126702038646808
TEO_HELP_FORUM_ID=1563328209444016332
TEO_MODEL=claude-opus-5-5
TEO_EFFORT=low
TEO_MAX_TOKENS=8000
TEO_USER_PER_HOUR=20
TEO_GUILD_PER_DAY=500
TEO_CONTEXT_MESSAGES=12
# Research projects: question-only mode (no channel history, no web tools). Comma-separated category ids.
TEO_PRIVATE_CATEGORY_IDS=809304610425798667
# Members with these roles may ask Teo to create server events (Discord's own event and admin
# permissions also count): Admin, ATR Alchemist, Professor, Researcher, ATR lab staff.
TEO_EVENT_ROLE_IDS=809127826628018206,1249179206487773264,1261864336574644345,809299070137008158,1415739835376734358
